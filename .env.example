# Docker Compose 部署配置，复制为项目根目录的 .env 后按需修改。
# .env 已被 Git 忽略；同名 shell 环境变量会覆盖文件中的值。
# 镜像、数据库路径和内部通信固定在 docker-compose.yml 中。

# 浏览器访问端口，默认 http://服务器IP:3004；不改端口时保持默认值。
SUB2API_CONSOLE_FRONTEND_PORT=3004

# 首次初始化必填：执行 openssl rand -hex 32 生成，粘贴到等号后。
# 在初始化页输入同一令牌；初始化完成后可清空，下次重建 API 容器时生效。
SUB2API_CONSOLE_SETUP_TOKEN=

# 后台任务池并发上限（不设置时使用代码内安全默认值）。
# 每个任务池另有有限等待队列，超过队列容量才会拒绝新任务。
SUB2API_TASK_QUEUE_CAPACITY=100
SUB2API_TASK_CONCURRENCY_ACCOUNT=8
SUB2API_TASK_CONCURRENCY_PROBE=8
SUB2API_TASK_CONCURRENCY_MODEL_CHECK=4
SUB2API_TASK_CONCURRENCY_ONBOARDING=4
SUB2API_TASK_CONCURRENCY_WORKBENCH=4
SUB2API_TASK_CONCURRENCY_LIVE=500
